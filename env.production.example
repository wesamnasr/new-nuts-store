# متغيرات بيئة الإنتاج لموقع وكاشير محمصة حفصة (Vercel + Neon Postgres)
# أضف هذه المتغيرات في لوحة تحكم Vercel (Settings -> Environment Variables)

# 1. رابط قاعدة البيانات المجمّعة من Neon (Pooled Connection String)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# 2. رابط قاعدة البيانات المباشر من Neon لتهيئة الجداول والترحيل (Direct / Unpooled)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 3. مفتاح تشفير جلسات الموظفين والإدارة (استبدله بسلسلة عشوائية من 64 حرفاً hex)
ADMIN_SESSION_SECRET="replace-with-random-64-hex-characters"

# 4. النطاق الرسمي المعتمد لمحمصة حفصة (المطبوع على الشنط والأكياس)
NEXT_PUBLIC_SITE_URL="https://hafsahnuts.com"
